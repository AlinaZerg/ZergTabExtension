{
  "manifest_version": 3,
  "name": "ZergTab",
  "version": "0.1.0",
  "description": "Канбан-доска для ссылок на новой вкладке",
  "permissions": ["storage", "tabs"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}